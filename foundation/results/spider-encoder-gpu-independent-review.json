  "decision": {
    "promotion": false,
    "interpretation": "Both arms pass512sampled base-velocity stop events without reset/timeouts. Measured-mode training reduces maximum stop time and slightly reduces moving torso load, torque-squared and GPU foot-site slip proxy, while increasing light idle support and slightly worsening XY/yaw tracking. These are one-training-seed conditional tradeoffs, not general superiority.",
    "native_boundary": "Independent native10-chain study confirms improved support in four adverse pairs but worse turning in fivepairs and foot-contact slip in three. Only the two nominal cases settle after returning to the unchanged default; all eight adverse returns remain nonquiet.",
    "future_training": "Use explicit deployment_measured mode for hardware-consistent new locomotion training. legacy_true remains reproducible historical training context; hardware always observes measured encoders. Export metadata records the training convention, not a way to remove unknown real bias."
  },
  "metric_definitions": {
    "support": "Actual simulated torso force divided by randomized bodyweight. Means pool scoredworld/time withinsegment, average seeds equally, then average segments equally.",
    "persistence": "First-to-last span of consecutive scored observations; report1%and10%BW thresholds, not continuous between-sample claims.",
    "stops": "After nonzero command, all26observations over0.5s satisfy planar<=.02m/s andabsbodyyaw<=.05rad/s; resets/timeouts refused. Initialzero baseline is not a post-motion stop. Native finalquiet also checksjoint motion and is a different measurement.",
    "slip": "GPU foot-site XYspeed gatedbycontact is a proxy; native force-weighted actualcontact tangentialspeed differs.",
    "holdout": "404 was fixed before this study and not used to selectarms; has been used in otherclassstudies."
  },
