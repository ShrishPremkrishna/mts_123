#!/usr/bin/env python3
"""Build the offline Pupper FC laptop ZIP for Apple silicon and Python 3.12."""
import argparse
import hashlib
from itertools import chain
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parent
FC = Path("final_project/pupper_fc")
VISION = Path("final_project/overhead_perception")
DOC = ROOT / FC / "LAPTOP.md"
LAPTOP = "pupper-fc-laptop.zip"
LOCK = FC / "requirements-macos-arm64-py312.lock"


def laptop_wheels():
    """Download only wheels pinned for the release's supported Mac."""
    lock = ROOT / LOCK
    pins = [line for line in lock.read_text().splitlines() if line and not line.startswith("#")]
    if not set((ROOT / FC / "requirements.txt").read_text().splitlines()) <= {line.split()[0] for line in pins}:
        raise ValueError("the Mac wheel lock must contain every pinned runtime requirement")
    directory = ROOT / "outputs" / "pupper-fc-wheels" / hashlib.sha256(lock.read_bytes()).hexdigest()[:16]
    directory.mkdir(parents=True, exist_ok=True)
    expected = {line.split("--hash=sha256:")[1] for line in pins}

    def verified_wheels():
        found = {hashlib.sha256(p.read_bytes()).hexdigest(): p for p in directory.glob("*.whl")}
        if expected <= found.keys():
            return {"wheels/" + found[d].name: found[d] for d in expected}
        return {}

    cached = verified_wheels()
    if cached:
        return cached
    subprocess.run([sys.executable, "-m", "pip", "download", "--disable-pip-version-check",
                    "--quiet", "--no-deps", "--only-binary=:all:", "--require-hashes",
                    "--platform", "macosx_15_0_arm64", "--python-version", "3.12",
                    "--implementation", "cp", "--abi", "cp312", "--dest", str(directory),
                    "-r", str(ROOT / LOCK)], check=True)
    cached = verified_wheels()
    if not cached:
        raise ValueError("downloaded wheels differ from the Mac wheel lock")
    return cached


def laptop_files():
    paths = [Path("Pupper FC.command"), Path("pupper-fc"), FC / "requirements.txt", LOCK, FC / "arena.json"]
    paths.extend(FC / (name + ".py") for name in (
        "__init__", "teleop", "setup_session", "lobby", "discovery", "field_transport", "arena_camera",
        "match_director", "balance_match", "controller", "model", "self_test"))
    paths.extend(FC / "static" / name for name in ("controls.html", "controls.css", "controls.mjs", "drive.mjs", "arena.webp"))
    paths.extend(VISION / "config" / name for name in ("field.yaml", "sim_field.yaml"))
    paths.append(VISION / "scripts/run_perception.py")
    paths.extend(VISION / "fieldcam" / (name + ".py") for name in (
        "__init__", "appearance", "camera_model", "capture", "clickcal", "colorpick",
        "config", "corner_anchor", "patch_plane", "team_colors", "detect", "filters", "net", "pipeline", "planner", "probe", "relative",
        "sim", "tagmeasure", "topdown"))
    return {**{p.as_posix(): ROOT / p for p in paths}, "READ-ME.md": DOC}


def contents(files):
    for name, source in sorted(files.items()):
        if source.is_symlink() or not source.is_file() or source.resolve() != source:
            raise ValueError("missing, nonregular or linked package input: " + str(source))
        data = source.read_bytes()
        if data.startswith(b"version https://git-lfs.github.com/spec/v1\n"):
            raise ValueError("Git LFS content is missing for " + str(source))
        yield name, data


def write_laptop(path, wheels, revision):
    with zipfile.ZipFile(path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        files = {**laptop_files(), **wheels}
        metadata = json.dumps({"source_commit": revision}, sort_keys=True).encode() + b"\n"
        for name, data in chain(contents(files), [("release-source.json", metadata)]):
            item = zipfile.ZipInfo("Pupper FC/" + name, date_time=(1980, 1, 1, 0, 0, 0))
            item.create_system = 3
            mode = 0o755 if name in ("pupper-fc", "Pupper FC.command") else 0o644
            item.external_attr = (0o100000 | mode) << 16
            compression = zipfile.ZIP_STORED if name.endswith(".whl") else zipfile.ZIP_DEFLATED
            archive.writestr(item, data, compress_type=compression, compresslevel=7)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=ROOT / "outputs/pupper-fc-release")
    dest = parser.parse_args().output.resolve()
    dest.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=dest, prefix=".packing-") as tmp:
        temp = Path(tmp)
        inputs = [str(path.relative_to(ROOT)) for path in laptop_files().values()]
        inputs.append(Path(__file__).name)
        revision = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
        tracked = subprocess.run(["git", "ls-files", "--error-unmatch", "--", *inputs], cwd=ROOT,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        changed = subprocess.run(["git", "diff", "--quiet", revision, "--", *inputs], cwd=ROOT)
        if tracked.returncode or changed.returncode:
            parser.exit(1, "Commit the package inputs before building a release.\n")
        write_laptop(temp / LAPTOP, laptop_wheels(), revision)
        digest = hashlib.sha256((temp / LAPTOP).read_bytes()).hexdigest()
        sums = LAPTOP + ".sha256"
        (temp / sums).write_text(f"{digest}  {LAPTOP}\n")
        for name in (LAPTOP, sums):
            os.replace(temp / name, dest / name)
    print(f"{digest}  {dest / LAPTOP}")


if __name__ == "__main__":
    main()
