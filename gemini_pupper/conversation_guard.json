  "purpose": "Best-effort English screening of tool-free conversation, not a semantic truth guarantee. Tool-bearing turns use only server receipts regardless of this filter.",
  "patterns": [
    "\\b(?:all set|all done|job done|mission accomplished|taken care of|carried out|on my way|heading your way)\\b",
    "^\\s*(?:queued|enqueued|scheduled|executed|completed|done|finished|stopped|standing|sitting|moving|walking|turning|sent|submitted|accepted|underway)[.! ]*$",
    "\\b(?:i|we|pupper|the robot|robot)\\s+(?:(?:have|has|had|'ve|'d)\\s+)?(?:(?:already|just|now|successfully|finally)\\s+)*(?:queued|enqueued|scheduled|executed|completed|moved|walked|turned|stood|sat|stopped|finished|sent|submitted|accepted|started|begun|began|performed|did|ran|jumped|shook|followed|relaxed|unlocked|locked|activated|deactivated)\\b",
    "\\b(?:i've|we've|i'd|we'd)\\s+(?:(?:already|just|now|successfully)\\s+)*(?:queued|enqueued|scheduled|executed|completed|moved|walked|turned|stood|sat|stopped|finished|sent|submitted|accepted|started|begun|performed|done|run|jumped|shaken|followed|relaxed|unlocked|locked|activated|deactivated)\\b",
    "\\b(?:i am|i'm|i have been|i've been|we are|we're|we have been|we've been|pupper is|the robot is|robot is)\\s+(?:(?:already|just|now|still|currently|successfully|safely|fully)\\s+)*(?:standing|sitting|moving|walking|turning|stopped|motionless|running|following|jumping|shaking|resting|lying|ready to move|in position|at rest)\\b",
    "\\b(?:the |your |that |this )?(?:command|request|action|movement|motion|move|walk|turn|trick|routine|sequence|plan)\\s+(?:is|was|has been|has|got|went)\\s+(?:(?:already|just|now|successfully)\\s+)*(?:queued|enqueued|scheduled|executed|completed|accepted|sent|submitted|started|underway|done|complete|finished|successful|well|perfectly|through)\\b",
    "\\b(?:i|i've|we|we've)\\s+(?:have |had |got |just |already )*(?:that|it|everything|your request|the request)\\s+(?:all )?(?:lined up|in the queue|under control|handled|sorted|ready|done)\\b",
    "\\b(?:that|it|the movement|the action)\\s+(?:went|worked|finished|ended)\\s+(?:well|perfectly|successfully|smoothly|safely)\\b",
    "\\b(?:queued|enqueued|scheduled|executed|completed)\\s+(?:it|that|this|your request|the request|the move|the action|the trick)\\b"
  ],
