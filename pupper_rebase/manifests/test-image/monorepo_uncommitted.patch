+    def _on_detections(self, msg: Detection2DArray):
+        """Track the closest person's bounding-box area (normalized) as a proximity signal.
+        Larger area == person is closer. Used by the greet patrol loop."""
+        best_area = 0.0
+        for det in msg.detections:
+            # Keep only person detections (COCO class id 0) when a hypothesis is present.
+            is_person = True
+            if det.results:
+                cid = str(det.results[0].hypothesis.class_id)
+                is_person = cid == PERSON_CLASS_ID
+            if not is_person:
+                continue
+            area = (float(det.bbox.size_x) * float(det.bbox.size_y)) / (DETECTION_IMAGE_W * DETECTION_IMAGE_H)
+            if area > best_area:
+                best_area = area
+        self.latest_person_bbox_area = best_area
+        self.latest_detection_time = time.time()
+
+    def _closest_person_area(self) -> float:
+        """Closest person's normalized bbox area, or 0.0 if detections are stale."""
+        if time.time() - self.latest_detection_time > GREET_DETECTION_TIMEOUT:
+            return 0.0
+        return self.latest_person_bbox_area
