 constexpr auto startup_timeout = std::chrono::seconds(15);
+// FC v1 stale tolerance (fc/robot/imu/u6-stale-tolerance.patch, 2026-11-23):
+// once read() has seen a good sample, a receipt gap is bridged by holding that
+// sample for up to stale_grace after the first stale read(), i.e. about 300 ms
+// without reports in total, instead of disabling motors on one 100 ms miss.
+// Non-finite values and bad quaternion norms still fail immediately.
+constexpr auto stale_grace = std::chrono::milliseconds(200);
+inline bool tolerable_gap(const char *error) {
+  return error && (std::strcmp(error, "stale IMU component receipt") == 0 ||
+                   std::strcmp(error, "missing complete IMU report") == 0);
+}
 
