+    const auto now = std::chrono::steady_clock::now();
+    const char *error = pupper_imu::feedback_error(imu_output, now);
+    const auto gap_ms = [&]() {
+      return std::chrono::duration<double, std::milli>(now - imu_gap_start_).count();
+    };
+    if (!error) {
+      if (imu_gap_start_ != std::chrono::steady_clock::time_point{}) {
+        // Receipts resumed: evidence for reader starvation rather than a BNO dropout.
+        RCLCPP_WARN(rclcpp::get_logger("ControlBoardHardwareInterface"),
+                    "FC_IMU_GAP resumed after %.0f ms held (event %u)", gap_ms(), imu_gap_events_);
+        imu_gap_start_ = {};
+      }
+      last_good_imu_ = imu_output;
+      have_good_imu_ = true;
+    } else if (have_good_imu_ && pupper_imu::tolerable_gap(error)) {
+      if (imu_gap_start_ == std::chrono::steady_clock::time_point{}) {
+        imu_gap_start_ = now;
+        ++imu_gap_events_;
+        RCLCPP_WARN(rclcpp::get_logger("ControlBoardHardwareInterface"),
+                    "FC_IMU_GAP %s; holding last good sample up to %ld ms (event %u)", error,
+                    static_cast<long>(pupper_imu::stale_grace.count()), imu_gap_events_);
+      }
+      if (now - imu_gap_start_ > pupper_imu::stale_grace) {
+        RCLCPP_ERROR(rclcpp::get_logger("ControlBoardHardwareInterface"),
+                     "%s for %.0f ms after grace start (event %u); disabling motors", error, gap_ms(),
+                     imu_gap_events_);
+        deactivate_motors();
+        return hardware_interface::return_type::ERROR;
+      }
+      imu_output = last_good_imu_;
+    } else {
       RCLCPP_ERROR(rclcpp::get_logger("ControlBoardHardwareInterface"), "%s; disabling motors", error);
       deactivate_motors();
       return hardware_interface::return_type::ERROR;
