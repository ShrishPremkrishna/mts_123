+// ---------------------------------------------------------------------------------
+// FC v1 IMU crutch (only reached with FC_IMU_FILTER=1)
+
+// Walk every report in one SHTP input packet: 0xFB base timestamp, then reports.
+// Report lengths from the SH-2 reference manual (6.5). Unknown IDs end the walk.
+void BNO055::fcParseAllReports(void) {
+  int dataLength = ((uint16_t)shtpHeader[1] << 8 | shtpHeader[0]) & 0x7FFF;
+  dataLength -= 4;
+  if (dataLength > MAX_PACKET_SIZE) dataLength = MAX_PACKET_SIZE;
+  if (dataLength < 5) return;
+  timeStamp = ((uint32_t)shtpData[4] << (8 * 3)) | (shtpData[3] << (8 * 2)) |
+              (shtpData[2] << (8 * 1)) | (shtpData[1] << (8 * 0));
+  int i = 5;
+  while (i < dataLength) {
+    const uint8_t id = shtpData[i];
+    int len = 0;
+    switch (id) {
+      case SENSOR_REPORTID_ACCELEROMETER:
+      case SENSOR_REPORTID_GYROSCOPE:
+      case SENSOR_REPORTID_MAGNETIC_FIELD:
+      case SENSOR_REPORTID_LINEAR_ACCELERATION:
+      case SENSOR_REPORTID_GRAVITY:
+        len = 10;
+        break;
+      case SENSOR_REPORTID_ROTATION_VECTOR:
+        len = 14;
+        break;
+      case SENSOR_REPORTID_GAME_ROTATION_VECTOR:
+        len = 12;
+        break;
+      case 0x07:  // uncalibrated gyro
+        len = 16;
+        break;
+      case 0xFA:  // timestamp rebase
+        len = 5;
+        break;
+      default:
+        return;
+    }
+    if (i + len > dataLength) return;
+    const uint8_t *r = &shtpData[i];
+    const uint16_t d1 = (uint16_t)r[5] << 8 | r[4];
+    const uint16_t d2 = (uint16_t)r[7] << 8 | r[6];
+    const uint16_t d3 = (uint16_t)r[9] << 8 | r[8];
+    if (id == SENSOR_REPORTID_ACCELEROMETER) {
+      accelAccuracy = r[2] & 0x03;
+      rawAccelX = d1;
+      rawAccelY = d2;
+      rawAccelZ = d3;
+      fcOnAccel();
+    } else if (id == SENSOR_REPORTID_GYROSCOPE) {
+      gyroAccuracy = r[2] & 0x03;
+      rawGyroX = d1;
+      rawGyroY = d2;
+      rawGyroZ = d3;
+      fcOnGyro(r[1]);
+    } else if (id == SENSOR_REPORTID_ROTATION_VECTOR) {
+      quatAccuracy = r[2] & 0x03;
+      rawQuatI = d1;
+      rawQuatJ = d2;
+      rawQuatK = d3;
+      rawQuatReal = (uint16_t)r[11] << 8 | r[10];
+      rawQuatRadianAccuracy = (uint16_t)r[13] << 8 | r[12];
+    }
+    i += len;
+  }
+}
+
+void BNO055::fcOnAccel(void) {
+  const double a[3] = {getAccelX(), getAccelY(), getAccelZ()};
+  fc_filter_->set_accel(a);
+  fc_accel_reports_++;
+  fc_accel_since_init_ = true;
+}
+
+// dt from the report sequence number (one step per report period): jitter-free and
+// counts dropped reports. The filter clamps a step to 50 ms.
+void BNO055::fcOnGyro(uint8_t seq) {
+  double dt = fc_period_s_;
+  if (fc_have_seq_) {
+    const uint8_t n = static_cast<uint8_t>(seq - fc_gyro_seq_);
+    dt = n * fc_period_s_;
+  }
+  fc_have_seq_ = true;
+  fc_gyro_seq_ = seq;
+  const double g[3] = {getGyroX(), getGyroY(), getGyroZ()};
+  fc_filter_->update_gyro(g, dt);
+  fc_gyro_reports_++;
+  if (fc_filter_->frozen()) {
+    fc_freeze_run_s_ += dt;
+  } else {
+    if (fc_freeze_run_s_ >= 0.2) {
+      printf("FC_IMU_FILTER gyro frozen %.2f s (rate held at 0, tilt from accel)\n", fc_freeze_run_s_);
+      fflush(stdout);
+    }
+    fc_freeze_run_s_ = 0.0;
+  }
+}
+
+void BNO055::fcMaybeLog(void) {
+  const auto now = std::chrono::steady_clock::now();
+  if (now - fc_last_log_ < std::chrono::seconds(10)) return;
+  fc_last_log_ = now;
+  if (fc_accel_reports_ == 0 && fc_gyro_reports_ > 0 && !fc_warned_no_accel_) {
+    printf("FC_IMU_FILTER WARNING: no accelerometer reports; publishing the stock rotation vector\n");
+    fc_warned_no_accel_ = true;
+  }
+  const fc_imu::FilterStats &s = fc_filter_->stats();
+  double b[3];
+  fc_filter_->bias(b);
+  const double rv[4] = {getQuatI(), getQuatJ(), getQuatK(), getQuatReal()};
+  printf(
+      "FC_IMU_FILTER gyro=%llu accel=%llu despiked=%llu frozen=%llu accel_skipped=%llu "
+      "longest_freeze=%.2fs xbase=%.4f pulse_mean=%.4f bias=(%.4f,%.4f,%.4f) rv_tilt_diff=%.1fdeg\n",
+      (unsigned long long)fc_gyro_reports_, (unsigned long long)fc_accel_reports_,
+      (unsigned long long)s.despiked, (unsigned long long)s.frozen_samples,
+      (unsigned long long)s.accel_skipped, s.longest_freeze_s, fc_filter_->x_baseline(),
+      fc_filter_->pulse_mean(), b[0], b[1], b[2], fc_filter_->tilt_diff_deg(rv));
+  fflush(stdout);
+}
diff -ruN a/control_board_hardware_interface/test/test_fc_imu_filter.cpp b/control_board_hardware_interface/test/test_fc_imu_filter.cpp
--- a/control_board_hardware_interface/test/test_fc_imu_filter.cpp	1969-12-31 16:00:00.000000000 -0800
+++ b/control_board_hardware_interface/control_board_hardware_interface/test/test_fc_imu_filter.cpp	2026-11-24 23:29:14.742353782 -0800
@@ -0,0 +1,255 @@
+// Unit test for rt/fc_imu_filter.hpp (FC v1 IMU crutch). Plain C++, no ROS/gtest.
+// Simulates the Pupper IMU (sensor pitched -135 deg about body y) with the observed
+// BNO085 faults: one-sided negative gyro-X pulses, X bias drift and output freezes.
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+#include "rt/fc_imu_filter.hpp"
+
+namespace {
+int failures = 0;
+void check(bool ok, const char *what, double val, double lim) {
+  printf("%s %-58s %.4f (limit %.4f)\n", ok ? "PASS" : "FAIL", what, val, lim);
+  if (!ok) failures++;
+}
+
+struct Q {
+  double w, x, y, z;
+};
+Q mul(const Q &a, const Q &b) {
+  return {a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z, a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
+          a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x, a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w};
+}
+Q expq(const double w[3], double dt) {
+  const double th = std::sqrt(w[0] * w[0] + w[1] * w[1] + w[2] * w[2]) * dt;
+  if (th < 1e-15) return {1, 0, 0, 0};
+  const double s = std::sin(th / 2) / th * dt;
+  return {std::cos(th / 2), w[0] * s, w[1] * s, w[2] * s};
+}
+void up_in(const Q &q, double v[3]) {  // world up in the rotated frame
+  v[0] = 2 * (q.x * q.z - q.w * q.y);
+  v[1] = 2 * (q.y * q.z + q.w * q.x);
+  v[2] = q.w * q.w - q.x * q.x - q.y * q.y + q.z * q.z;
+}
+// error of the internal estimate (the published one is deliberately held during a freeze)
+double tilt_err_deg(const fc_imu::AttitudeFilter &f, const Q &truth) {
+  const double xyzw[4] = {truth.x, truth.y, truth.z, truth.w};
+  return f.tilt_diff_deg(xyzw);
+}
+
+struct Scenario {
+  const char *name;
+  double seconds = 60;
+  double motion_amp = 0;      // rad, body roll/pitch oscillation amplitude
+  double pulse_per_s = 0;     // X pulses per second
+  double bias_x = 0;          // rad/s constant X offset
+  double accel_osc = 0;       // m/s^2 gait-like linear accel amplitude
+  double freeze_every = 0;    // s, 0 = no freezes
+  double freeze_len = 0;      // s
+  bool freeze_accel = false;  // whole-chip freeze
+};
+
+struct Result {
+  double max_err_after_2s = 0, p99_err = 0, quiet_x_std = 0, max_rate_during_freeze = 0;
+  bool held_exactly = true;
+  bool pub_held_on_gyro_freeze = true;
+};
+
+Result run(const Scenario &sc, unsigned seed = 1) {
+  const double dt = 0.01, g = 9.80665, k = std::sqrt(0.5);
+  std::mt19937 rng(seed);
+  std::normal_distribution<double> n_gyro(0, 0.002), n_acc(0, 0.03);
+  std::uniform_real_distribution<double> u(0, 1);
+  // mount: sensor = body * Ry(-135 deg)
+  const Q mount = {std::cos(-135.0 * M_PI / 360), 0, std::sin(-135.0 * M_PI / 360), 0};
+  Q body = {1, 0, 0, 0};
+  fc_imu::AttitudeFilter f;
+  double pulse_amp = 0, pulse_tau = 0.01, pulse_left = 0;
+  double next_freeze = sc.freeze_every, freeze_left = 0;
+  double gfrozen[3] = {0, 0, 0}, afrozen[3] = {0, 0, 0};
+  std::vector<double> errs;
+  double sx = 0, sxx = 0;
+  int nq = 0;
+  Result r;
+  double q_hold[4] = {0, 0, 0, 0};
+  bool hold_valid = false;
+  double qpub[4] = {0, 0, 0, 0};
+  bool pub_valid = false;
+  for (int i = 0; i * dt < sc.seconds; i++) {
+    const double t = i * dt;
+    // body rates (body frame): roll/pitch oscillation + slow yaw
+    double wb[3] = {sc.motion_amp * 2 * M_PI * 1.0 * std::cos(2 * M_PI * 1.0 * t),
+                    sc.motion_amp * 2 * M_PI * 0.7 * std::cos(2 * M_PI * 0.7 * t + 1), 0.2 * sc.motion_amp};
+    // sensor-frame true rate: R_mount^T wb (rotation about y by -135 deg)
+    const double c = -k, s = -k;  // cos/sin(-135)
+    double ws[3] = {c * wb[0] - s * wb[2], wb[1], s * wb[0] + c * wb[2]};
+    body = mul(body, expq(wb, dt));
+    const Q sensor = mul(body, mount);
+    double up[3];
+    up_in(sensor, up);
+    // specific force: g*up + linear accel (body x/z gait oscillation, in sensor frame)
+    const double ax_b = sc.accel_osc * std::sin(2 * M_PI * 2.5 * t), az_b = sc.accel_osc * std::sin(2 * M_PI * 2.5 * t + 1);
+    double acc[3] = {g * up[0] + c * ax_b - s * az_b + n_acc(rng), g * up[1] + n_acc(rng),
+                     g * up[2] + s * ax_b + c * az_b + n_acc(rng)};
+    double gy[3] = {ws[0] + n_gyro(rng) + sc.bias_x, ws[1] + n_gyro(rng), ws[2] + n_gyro(rng)};
+    // one-sided negative step-and-decay pulses, 0.03-0.3 rad/s, 15-40 ms
+    if (pulse_left <= 0 && u(rng) < sc.pulse_per_s * dt) {
+      pulse_amp = 0.03 + 0.27 * u(rng);
+      pulse_left = 0.015 + 0.025 * u(rng);
+      pulse_tau = pulse_left / 2;
+    }
+    if (pulse_left > 0) {
+      gy[0] -= pulse_amp;
+      pulse_amp *= std::exp(-dt / pulse_tau);
+      pulse_left -= dt;
+    }
+    // freezes: outputs bit-identical while reports keep arriving
+    bool freezing = false;
+    if (sc.freeze_every > 0 && t >= next_freeze && freeze_left <= 0) {
+      freeze_left = sc.freeze_len;
+      next_freeze = t + sc.freeze_every;
+      for (int j = 0; j < 3; j++) {
+        gfrozen[j] = gy[j] - 0.25;  // frozen at a pulse value: worst case for integration
+        afrozen[j] = acc[j];
+      }
+    }
+    if (freeze_left > 0) {
+      freezing = true;
+      freeze_left -= dt;
+      for (int j = 0; j < 3; j++) {
+        gy[j] = gfrozen[j];
+        if (sc.freeze_accel) acc[j] = afrozen[j];
+      }
+    }
+    f.set_accel(acc);
+    f.update_gyro(gy, dt);
+    double rate[3];
+    f.rate(rate);
+    if (freezing && f.frozen()) {
+      for (double v : rate) r.max_rate_during_freeze = std::fmax(r.max_rate_during_freeze, std::fabs(v));
+      double qp[4];
+      f.quat_xyzw(qp);
+      if (pub_valid && (qp[0] != qpub[0] || qp[1] != qpub[1] || qp[2] != qpub[2] || qp[3] != qpub[3]))
+        r.pub_held_on_gyro_freeze = false;
+      for (int j = 0; j < 4; j++) qpub[j] = qp[j];
+      pub_valid = true;
+      if (sc.freeze_accel) {
+        double q[4];
+        f.quat_xyzw(q);
+        if (hold_valid && (q[0] != q_hold[0] || q[1] != q_hold[1] || q[2] != q_hold[2] || q[3] != q_hold[3]))
+          r.held_exactly = false;
+        // accel freeze needs accel_freeze_n repeats before the hold starts
+        if (f.stats().accel_frozen_samples > 0) {
+          for (int j = 0; j < 4; j++) q_hold[j] = q[j];
+          hold_valid = true;
+        }
+      }
+    } else {
+      hold_valid = false;
+      pub_valid = false;
+    }
+    if (f.quiet() && !f.frozen()) {
+      sx += rate[0];
+      sxx += rate[0] * rate[0];
+      nq++;
+    }
+    if (t >= 2.0) {
+      const double e = tilt_err_deg(f, sensor);
+      errs.push_back(e);
+      r.max_err_after_2s = std::fmax(r.max_err_after_2s, e);
+    }
+  }
+  std::sort(errs.begin(), errs.end());
+  r.p99_err = errs.empty() ? 0 : errs[static_cast<size_t>(0.99 * (errs.size() - 1))];
+  r.quiet_x_std = nq > 1 ? std::sqrt(std::fmax(0.0, sxx / nq - (sx / nq) * (sx / nq))) : 0;
+  return r;
+}
+}  // namespace
+
+int main() {
+  {
+    Scenario s{"clean, still"};
+    Result r = run(s);
+    check(r.max_err_after_2s < 0.3, "clean still: max tilt error (deg)", r.max_err_after_2s, 0.3);
+  }
+  {
+    Scenario s{"rest, bias -0.115 + 33 pulses/s (2000/min)"};
+    s.seconds = 120;
+    s.bias_x = -0.115;
+    s.pulse_per_s = 33;
+    Result r = run(s);
+    check(r.max_err_after_2s < 2.0, "still, X bias -0.115 + 2000 pulses/min: max err (deg)", r.max_err_after_2s, 2.0);
+    check(r.quiet_x_std < 0.01, "still, despiked published X std (rad/s)", r.quiet_x_std, 0.01);
+  }
+  {
+    Scenario s{"walking-like motion + faults"};
+    s.seconds = 120;
+    s.motion_amp = 0.1;
+    s.bias_x = -0.1;
+    s.pulse_per_s = 20;
+    s.accel_osc = 2.0;
+    Result r = run(s);
+    check(r.p99_err < 3.0, "moving +-6 deg, gait accel 2 m/s^2, X faults: p99 err (deg)", r.p99_err, 3.0);
+    check(r.max_err_after_2s < 4.0, "moving +-6 deg, gait accel 2 m/s^2, X faults: max err", r.max_err_after_2s, 4.0);
+  }
+  {
+    Scenario s{"gyro freezes, accel live"};
+    s.seconds = 60;
+    s.motion_amp = 0.05;
+    s.freeze_every = 5;
+    s.freeze_len = 1.5;
+    s.pulse_per_s = 10;
+    s.bias_x = -0.05;
+    Result r = run(s);
+    // accel-only lag while the gyro is frozen: ~2x the motion amplitude (+-3 deg at 1 Hz here)
+    check(r.max_err_after_2s < 6.0, "1.5 s gyro freezes while moving +-3 deg: max err (deg)", r.max_err_after_2s, 6.0);
+    check(r.max_rate_during_freeze == 0.0, "published rate during a detected freeze", r.max_rate_during_freeze, 0.0);
+    check(r.pub_held_on_gyro_freeze, "gyro frozen: published quaternion held (bridge guard sees it)",
+          r.pub_held_on_gyro_freeze ? 1 : 0, 1);
+  }
+  {
+    Scenario s{"whole-chip freezes"};
+    s.seconds = 30;
+    s.freeze_every = 5;
+    s.freeze_len = 1.0;
+    s.freeze_accel = true;
+    Result r = run(s);
+    check(r.held_exactly, "gyro+accel frozen: quaternion held bit-exactly", r.held_exactly ? 1 : 0, 1);
+    check(r.max_err_after_2s < 1.0, "gyro+accel frozen (robot still): max err (deg)", r.max_err_after_2s, 1.0);
+  }
+  {
+    // Still robot, chip repeating a quantized ~0 rate for 30 s (seen on mts): not a freeze,
+    // orientation keeps following accel (a slow 3 deg lean must reach the published tilt).
+    fc_imu::AttitudeFilter f;
+    const double g = 9.80665;
+    const double gy[3] = {0.00195, 0.0, -0.00195};
+    std::mt19937 rng(3);
+    std::normal_distribution<double> na(0, 0.03);  // real accel noise (never 4 identical samples)
+    double maxerr = 0;
+    bool any_frozen = false;
+    for (int i = 0; i < 3000; i++) {
+      const double lean = (i > 1000) ? std::fmin(3.0, (i - 1000) * 0.003) * M_PI / 180 : 0.0;
+      // body pitched by `lean`; sensor = body * Ry(-135): sensor up = Ry(135+lean)^T z
+      const double th = -135.0 * M_PI / 180 - lean;
+      const double a[3] = {-std::sin(th) * g + na(rng), na(rng), std::cos(th) * g + na(rng)};
+      f.set_accel(a);
+      f.update_gyro(gy, 0.01);
+      any_frozen = any_frozen || f.frozen();
+      if (i > 2500) {
+        double q[4];
+        f.quat_xyzw(q);
+        const double up[3] = {2 * (q[0] * q[2] - q[3] * q[1]), 2 * (q[1] * q[2] + q[3] * q[0]),
+                              q[3] * q[3] - q[0] * q[0] - q[1] * q[1] + q[2] * q[2]};
+        const double c = (up[0] * a[0] + up[1] * a[1] + up[2] * a[2]) / std::sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
+        maxerr = std::fmax(maxerr, std::acos(std::fmin(1.0, c)) * 180 / M_PI);
+      }
+    }
+    check(!any_frozen, "still chip repeating ~0 rate 30 s: not flagged frozen", any_frozen ? 1 : 0, 0);
+    check(maxerr < 1.0, "still chip repeating ~0: published tilt follows a 3 deg lean", maxerr, 1.0);  // vs noisy accel
+  }
+  printf("%s (%d failure%s)\n", failures ? "FAILED" : "ALL PASSED", failures, failures == 1 ? "" : "s");
+  return failures ? 1 : 0;
+}
diff -ruN a/control_board_hardware_interface/test/test_fc_imu_stall.cpp b/control_board_hardware_interface/test/test_fc_imu_stall.cpp
--- a/control_board_hardware_interface/test/test_fc_imu_stall.cpp	1969-12-31 16:00:00.000000000 -0800
+++ b/control_board_hardware_interface/control_board_hardware_interface/test/test_fc_imu_stall.cpp	2026-11-24 23:29:14.742353782 -0800
@@ -0,0 +1,141 @@
+// Unit test for rt/fc_imu_stall.hpp (FC v3 BNO stall guard). Plain C++, no ROS/gtest.
+// Simulates the IMU thread: a poll every 1 ms, input reports at 200/s when the chip is alive,
+// a re-init that blocks for 0.5 s (soft reset sleeps 2 x 200 ms) and may or may not revive it.
+#include <cmath>
+#include <cstdio>
+#include <functional>
+#include <vector>
+
+#include "rt/fc_imu_stall.hpp"
+
+namespace {
+int failures = 0;
+void check(bool ok, const char *what, double val, double lim) {
+  printf("%s %-62s %.3f (limit %.3f)\n", ok ? "PASS" : "FAIL", what, val, lim);
+  if (!ok) failures++;
+}
+
+struct Sim {
+  fc_imu::StallMonitor m;
+  double t = 0;
+  uint64_t reports = 0;
+  double next_report = 0;
+  int reinits = 0;
+  std::vector<double> reinit_times;
+  double first_stall = -1, recovered_at = -1;
+  bool was_stalled = false;
+  int stall_entries = 0;
+  // alive(t, reinits) -> chip produces reports; ready(t) -> driver output valid
+  std::function<bool(double, int)> alive;
+  std::function<bool(double)> ready = [](double) { return true; };
+
+  explicit Sim(const fc_imu::StallParams &p = fc_imu::StallParams()) : m(p) {}
+
+  void run(double until) {
+    while (t < until) {
+      if (alive(t, reinits) && t >= next_report) {
+        reports++;
+        next_report = t + 0.005;
+      }
+      auto a = m.update(t, reports, ready(t));
+      if (m.stalled() && !was_stalled) {
+        stall_entries++;
+        if (first_stall < 0) first_stall = t;
+      }
+      if (!m.stalled() && was_stalled) recovered_at = t;
+      was_stalled = m.stalled();
+      if (a == fc_imu::StallMonitor::Action::kReinit) {
+        reinit_times.push_back(t);
+        reinits++;
+        t += 0.5;  // blocking re-init
+        m.reinit_done(t, alive(t, reinits), 0.5);
+      }
+      m.take_log();
+      t += 0.001;
+    }
+  }
+};
+}  // namespace
+
+int main() {
+  {
+    Sim s;
+    s.alive = [](double, int) { return true; };
+    s.run(30);
+    check(s.stall_entries == 0, "healthy 200 Hz for 30 s: no stall", s.stall_entries, 0);
+  }
+  {
+    Sim s;  // 150 ms hiccup at t=5
+    s.alive = [](double t, int) { return t < 5.0 || t > 5.15; };
+    s.run(10);
+    check(s.stall_entries == 0, "150 ms report gap: no stall", s.stall_entries, 0);
+  }
+  {
+    Sim s;  // 350 ms gap at t=5: stalls at ~0.2 s, recovers by itself before the first re-init
+    s.alive = [](double t, int) { return t < 5.0 || t > 5.35; };
+    s.run(10);
+    check(s.stall_entries == 1, "350 ms gap: one stall", s.stall_entries, 1);
+    check(std::fabs(s.first_stall - 5.2) < 0.01, "350 ms gap: stall flagged 200 ms after the last report",
+          s.first_stall, 5.2);
+    check(s.reinits == 0, "350 ms gap: no re-init (first one is due at 500 ms)", s.reinits, 0);
+    check(s.recovered_at > 5.35 && s.recovered_at < 5.42, "350 ms gap: cleared after 10 fresh reports",
+          s.recovered_at, 5.42);
+  }
+  {
+    Sim s;  // chip dead from t=5 until the 3rd re-init
+    s.alive = [](double t, int n) { return t < 5.0 || n >= 3; };
+    s.run(20);
+    check(s.reinits == 3, "dead until re-init #3: exactly 3 re-inits", s.reinits, 3);
+    check(std::fabs(s.reinit_times[0] - 5.5) < 0.01, "first re-init 500 ms after the last report",
+          s.reinit_times[0], 5.5);
+    check(!s.m.stalled() && s.recovered_at > 0, "dead until re-init #3: recovered", s.recovered_at, 0);
+    check(s.m.stalls() == 1, "dead until re-init #3: one stall episode", s.m.stalls(), 1);
+  }
+  {
+    Sim s;  // hung forever (the 2026-11-25 I2C bus hang)
+    s.alive = [](double t, int) { return t < 5.0; };
+    s.run(5 + 120);
+    // re-inits at 5.5, then spacing 0.5,1,2,4,5,5,5,5,5 (+0.5 s each re-init) for 10 fast, then every 30 s
+    double gap_max_fast = 0;
+    for (int i = 1; i < 10 && i < (int)s.reinit_times.size(); i++)
+      gap_max_fast = std::fmax(gap_max_fast, s.reinit_times[i] - s.reinit_times[i - 1]);
+    check(gap_max_fast <= 5.5 + 0.01, "hung bus: fast re-inits spaced <= 5 s (+0.5 s blocking)", gap_max_fast,
+          5.51);
+    check(s.reinit_times.size() >= 11 && s.reinit_times[10] - s.reinit_times[9] > 29.9,
+          "hung bus: after 10 fast re-inits, one every 30 s",
+          s.reinit_times.size() >= 11 ? s.reinit_times[10] - s.reinit_times[9] : 0, 30);
+    check(s.reinits <= 14, "hung bus: re-inits bounded in 120 s", s.reinits, 14);
+    check(s.m.stalled(), "hung bus: still flagged stalled", s.m.stalled(), 1);
+  }
+  {
+    Sim s;  // reports back after re-init #1 but the filter needs 0.3 s to re-seed
+    double back = -1;
+    s.alive = [](double t, int n) { return t < 5.0 || n >= 1; };
+    s.ready = [&](double t) {
+      if (s.reinits >= 1 && back < 0) back = t;
+      return s.reinits == 0 || (back >= 0 && t - back > 0.3);
+    };
+    s.run(10);
+    check(s.recovered_at > back + 0.3 - 1e-6, "reports back but output not valid: stays stalled until valid",
+          s.recovered_at - back, 0.3);
+    check(s.reinits == 1, "re-seed wait does not trigger more re-inits", s.reinits, 1);
+  }
+  {
+    Sim s;  // no report ever since start (bus already hung at start-up)
+    s.alive = [](double, int) { return false; };
+    s.run(5);
+    check(std::fabs(s.first_stall - 3.0) < 0.01, "no report since start: stalled after the 3 s grace",
+          s.first_stall, 3.0);
+    check(!s.reinit_times.empty() && std::fabs(s.reinit_times[0] - 3.0) < 0.01,
+          "no report since start: re-init right away", s.reinit_times.empty() ? -1 : s.reinit_times[0], 3.0);
+  }
+  {
+    Sim s;  // second, independent stall after recovery: counters restart
+    s.alive = [](double t, int) { return t < 5.0 || (t > 5.3 && t < 8.0) || t > 8.3; };
+    s.run(12);
+    check(s.m.stalls() == 2 && s.stall_entries == 2, "two separate gaps: two stall episodes", s.m.stalls(), 2);
+    check(!s.m.stalled(), "two separate gaps: clear at the end", s.m.stalled(), 0);
+  }
+  printf("%s (%d failure%s)\n", failures ? "FAILED" : "ALL PASSED", failures, failures == 1 ? "" : "s");
+  return failures ? 1 : 0;
+}
