diff -ruN a/control_board_hardware_interface/include/rt/fc_imu_filter.hpp b/control_board_hardware_interface/include/rt/fc_imu_filter.hpp
--- a/control_board_hardware_interface/include/rt/fc_imu_filter.hpp	1969-12-31 16:00:00
+++ b/control_board_hardware_interface/include/rt/fc_imu_filter.hpp	2026-11-23 23:47:10
@@ -0,0 +1,300 @@
+// FC v1 IMU crutch: our own roll/pitch estimate for a BNO085 whose gyro X axis
+// emits one-sided negative pulses, drifts in bias and sometimes freezes.
+//
+// Mahony complementary filter in the SENSOR frame:
+//   q (sensor -> world, world z up, same convention as the BNO rotation vector)
+//   is integrated from the sanitized gyro and pulled toward the measured gravity
+//   direction with gain kp (tilt time constant 1/kp seconds). A slow integral term
+//   learns the residual gyro bias. Yaw is gyro-only (not observable from gravity).
+//
+// Gyro X sanitizer (sensor frame; the fault is on X only):
+//   * "quiet": bias-corrected Y and Z both below quiet_rate, i.e. the body is not
+//     rotating. Then X should read its clean baseline b0. Samples more than
+//     spike_thresh below b0 are pulses and are replaced by b0.
+//   * b0 tracks a high quantile of X in quiet samples (pulses are one-sided negative,
+//     so the clean level sits at the top of the distribution).
+//   * m is the mean pulse contribution (EMA of X - b0 in quiet samples). While the
+//     body moves, pulses cannot be told from motion sample by sample, so X - b0 - m
+//     is used: the pulses' average effect is removed and the accel corrects the rest.
+// Freeze: gyro bit-identical for freeze_s while its value is not ~0 or the accel shows
+//   motion (a still chip repeats ~0 for seconds) -> rate treated as unknown (0), the filter
+//   runs on accel only. Accel bit-identical for accel_freeze_n samples -> no accel
+//   correction (orientation held). While the gyro is frozen the PUBLISHED quaternion
+//   and rate are held bit-identical (the internal estimate keeps tracking accel), so
+//   the bridge's existing frozen-output guard still sees a freeze and stops the walker:
+//   in sim, walking through 0.3-1.5 s gyro freezes without angular rate fell 4/6.
+//
+// No ROS/Eigen dependency so the identical code is used by the driver, the unit
+// test and the offline replay/sim harnesses (via a C shim).
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+namespace fc_imu {
+
+struct FilterParams {
+  double kp = 2.0;               // 1/s, accel correction gain
+  double ki = 0.3;               // 1/s^2, integral (gyro bias) gain
+  double kp_frozen = 2.0;        // 1/s, accel gain while the gyro is frozen (8 leaked gait accel in sim)
+  double kp_min_frac = 0.5;      // fraction of kp kept when |a| is far from 1 g
+  double accel_band = 0.3;       // | |a|/g - 1 | at which the weight reaches its floor
+  double accel_reject = 1.0;     // | |a|/g - 1 | above which accel is ignored entirely
+  double ki_band = 0.3;          // integral runs only within this band of 1 g
+  double bias_limit = 0.2;       // rad/s clamp on the integral bias
+  double quiet_rate = 0.03;      // rad/s, Y/Z below this = not rotating
+  double spike_thresh = 0.015;   // rad/s below b0 = pulse (quiet samples)
+  double baseline_step = 2e-4;   // rad/s per quiet sample, quantile tracker step
+  double baseline_quantile = 0.9;
+  double baseline_limit = 0.05;  // rad/s clamp on b0
+  double pulse_mean_tau = 5.0;   // s
+  double pulse_mean_limit = 0.15;
+  double freeze_s = 0.04;        // gyro bit-identical this long = frozen ...
+  double freeze_rate_min = 0.02; // ... only if the held value is not ~0 (rad/s) ...
+  double freeze_accel_act = 0.3; // ... or the accel shows motion (m/s^2, mean |a - lowpass|).
+                                 // A still BNO legitimately repeats ~0 for many seconds (mts 2026-11-24).
+  int accel_freeze_n = 4;        // accel bit-identical this many repeats = frozen
+  double accel_max_age = 0.1;    // s without a new accel sample = no correction
+  double accel_lp_tau = 0.1;     // s, low-pass on the accel VECTOR before use (mean, not mean direction)
+  double max_dt = 0.05;          // s, clamp per step (report gaps)
+  double g = 9.80665;
+};
+
+struct FilterStats {
+  uint64_t samples = 0;
+  uint64_t despiked = 0;          // quiet X samples replaced
+  uint64_t frozen_samples = 0;    // gyro steps run as frozen
+  uint64_t accel_frozen_samples = 0;
+  uint64_t accel_skipped = 0;     // steps without accel correction (frozen/old/out of band)
+  double longest_freeze_s = 0.0;
+};
+
+class AttitudeFilter {
+ public:
+  explicit AttitudeFilter(const FilterParams &p = FilterParams()) : p_(p) {}
+
+  const FilterParams &params() const { return p_; }
+  const FilterStats &stats() const { return st_; }
+  bool initialized() const { return init_; }
+
+  // Latest accelerometer sample, sensor frame, m/s^2 specific force (+g up at rest).
+  void set_accel(const double a[3]) {
+    if (have_acc_ && a[0] == acc_[0] && a[1] == acc_[1] && a[2] == acc_[2]) {
+      acc_same_n_++;
+    } else {
+      acc_same_n_ = 0;
+    }
+    for (int i = 0; i < 3; i++) acc_[i] = a[i];
+    have_acc_ = true;
+    acc_age_ = 0.0;
+    if (!init_) init_from_accel();
+  }
+
+  // One gyro sample (sensor frame, rad/s) and the time since the previous one.
+  void update_gyro(const double g[3], double dt) {
+    if (!(dt > 0.0)) dt = 0.0;
+    if (dt > p_.max_dt) dt = p_.max_dt;
+    st_.samples++;
+    acc_age_ += dt;
+
+    // Freeze detector (bit-identical gyro).
+    if (have_gyro_ && g[0] == gprev_[0] && g[1] == gprev_[1] && g[2] == gprev_[2]) {
+      same_s_ += dt;
+    } else {
+      same_s_ = 0.0;
+    }
+    for (int i = 0; i < 3; i++) gprev_[i] = g[i];
+    have_gyro_ = true;
+    if (have_acc_) {
+      const double d0 = acc_[0] - acc_lp_[0], d1 = acc_[1] - acc_lp_[1], d2 = acc_[2] - acc_lp_[2];
+      act_ += 0.1 * (std::sqrt(d0 * d0 + d1 * d1 + d2 * d2) - act_);
+    }
+    const bool nonzero = std::fabs(g[0] - b0_) > p_.freeze_rate_min || std::fabs(g[1]) > p_.freeze_rate_min ||
+                         std::fabs(g[2]) > p_.freeze_rate_min;
+    frozen_ = same_s_ >= p_.freeze_s && (nonzero || act_ > p_.freeze_accel_act);
+    if (same_s_ > st_.longest_freeze_s) st_.longest_freeze_s = same_s_;
+
+    // Sanitize.
+    double w[3];
+    despiked_ = false;
+    if (frozen_) {
+      st_.frozen_samples++;
+      w[0] = w[1] = w[2] = 0.0;
+    } else {
+      const double yc = g[1] + ifb_[1], zc = g[2] + ifb_[2];
+      quiet_ = std::fabs(yc) < p_.quiet_rate && std::fabs(zc) < p_.quiet_rate;
+      const double dx = g[0] - b0_;
+      if (quiet_) {
+        // quantile tracker for the clean X level
+        b0_ += (dx < 0.0) ? -p_.baseline_step * (1.0 - p_.baseline_quantile)
+                          : p_.baseline_step * p_.baseline_quantile;
+        b0_ = clamp(b0_, -p_.baseline_limit, p_.baseline_limit);
+        const double a = (dt > 0.0) ? dt / (p_.pulse_mean_tau + dt) : 0.0;
+        m_ = clamp(m_ + a * (dx - m_), -p_.pulse_mean_limit, 0.02);
+        if (dx < -p_.spike_thresh) {
+          w[0] = 0.0;
+          despiked_ = true;
+          st_.despiked++;
+        } else {
+          w[0] = dx;
+        }
+      } else {
+        w[0] = dx - m_;
+      }
+      w[1] = g[1];
+      w[2] = g[2];
+    }
+    // Published rate: X sanitized, Y/Z exactly as measured (clean axes; the integral
+    // bias stays internal so accel leakage can never bias the policy's rate input).
+    for (int i = 0; i < 3; i++) rate_[i] = w[i];
+    if (!frozen_) {
+      for (int i = 0; i < 3; i++) w[i] += ifb_[i];
+    }
+    if (!init_) return;
+
+    // Accel correction.
+    double wc[3] = {w[0], w[1], w[2]};
+    const bool acc_frozen = acc_same_n_ >= p_.accel_freeze_n;
+    if (acc_frozen) st_.accel_frozen_samples++;
+    bool corrected = false;
+    if (have_acc_ && !acc_frozen && acc_age_ <= p_.accel_max_age) {
+      // Low-pass the vector: the time-mean of specific force is gravity even while
+      // trotting; the mean of its normalised direction is not (bias seen in sim).
+      const double al = (dt > 0.0) ? dt / (p_.accel_lp_tau + dt) : 0.0;
+      for (int i = 0; i < 3; i++) acc_lp_[i] += al * (acc_[i] - acc_lp_[i]);
+      const double n = std::sqrt(acc_lp_[0] * acc_lp_[0] + acc_lp_[1] * acc_lp_[1] + acc_lp_[2] * acc_lp_[2]);
+      const double dev = std::fabs(n / p_.g - 1.0);
+      if (n > 1e-6 && dev < p_.accel_reject) {
+        const double ax = acc_lp_[0] / n, ay = acc_lp_[1] / n, az = acc_lp_[2] / n;
+        double v[3];
+        up_in_sensor(v);
+        const double e[3] = {ay * v[2] - az * v[1], az * v[0] - ax * v[2], ax * v[1] - ay * v[0]};
+        const double frac = dev / p_.accel_band;
+        const double wgt = 1.0 - (1.0 - p_.kp_min_frac) * (frac < 1.0 ? frac : 1.0);
+        const double kp = frozen_ ? p_.kp_frozen : p_.kp;
+        for (int i = 0; i < 3; i++) wc[i] += kp * wgt * e[i];
+        if (!frozen_ && dev < p_.ki_band) {
+          for (int i = 0; i < 3; i++) {
+            ifb_[i] = clamp(ifb_[i] + p_.ki * e[i] * dt, -p_.bias_limit, p_.bias_limit);
+          }
+        }
+        corrected = true;
+      }
+    }
+    if (!corrected) st_.accel_skipped++;
+    if (!(frozen_ && !corrected)) integrate(wc, dt);  // both frozen: nothing known, hold
+    if (!frozen_) {
+      for (int i = 0; i < 4; i++) qpub_[i] = q_[i];
+    }
+  }
+
+  // Published orientation sensor -> world, Eigen/ROS order (held while the gyro is frozen).
+  void quat_xyzw(double out[4]) const {
+    out[0] = qpub_[1];
+    out[1] = qpub_[2];
+    out[2] = qpub_[3];
+    out[3] = qpub_[0];
+  }
+  // Internal estimate (keeps tracking accel through a gyro freeze).
+  void quat_internal_xyzw(double out[4]) const {
+    out[0] = q_[1];
+    out[1] = q_[2];
+    out[2] = q_[3];
+    out[3] = q_[0];
+  }
+  // Published angular velocity, sensor frame: X de-spiked/de-biased, Y/Z raw, 0 when frozen.
+  void rate(double out[3]) const {
+    for (int i = 0; i < 3; i++) out[i] = rate_[i];
+  }
+  // Angle between the filter's gravity and the gravity of another quaternion (xyzw), deg.
+  double tilt_diff_deg(const double other_xyzw[4]) const {
+    double v[3];
+    up_in_sensor(v);
+    const double x = other_xyzw[0], y = other_xyzw[1], z = other_xyzw[2], w = other_xyzw[3];
+    const double o[3] = {2 * (x * z - w * y), 2 * (y * z + w * x), w * w - x * x - y * y + z * z};
+    const double on = std::sqrt(o[0] * o[0] + o[1] * o[1] + o[2] * o[2]);
+    if (on < 1e-9) return NAN;
+    double c = (v[0] * o[0] + v[1] * o[1] + v[2] * o[2]) / on;
+    c = clamp(c, -1.0, 1.0);
+    return std::acos(c) * 180.0 / M_PI;
+  }
+  // Seconds of gyro steps since the last accel sample (large = accel stream missing).
+  double accel_age() const { return acc_age_; }
+  bool frozen() const { return frozen_; }
+  bool despiked() const { return despiked_; }
+  bool quiet() const { return quiet_; }
+  double x_baseline() const { return b0_; }
+  double pulse_mean() const { return m_; }
+  void bias(double out[3]) const {
+    for (int i = 0; i < 3; i++) out[i] = -ifb_[i];
+  }
+
+ private:
+  static double clamp(double v, double lo, double hi) { return v < lo ? lo : (v > hi ? hi : v); }
+
+  // World up expressed in the sensor frame (third row of R(q)).
+  void up_in_sensor(double v[3]) const {
+    const double w = q_[0], x = q_[1], y = q_[2], z = q_[3];
+    v[0] = 2 * (x * z - w * y);
+    v[1] = 2 * (y * z + w * x);
+    v[2] = w * w - x * x - y * y + z * z;
+  }
+
+  void init_from_accel() {
+    const double n = std::sqrt(acc_[0] * acc_[0] + acc_[1] * acc_[1] + acc_[2] * acc_[2]);
+    if (n < 0.5 * p_.g || n > 1.5 * p_.g) return;
+    for (int i = 0; i < 3; i++) acc_lp_[i] = acc_[i];
+    const double a[3] = {acc_[0] / n, acc_[1] / n, acc_[2] / n};
+    // rotation taking a (sensor) onto world up: axis a x z, angle acos(a.z)
+    double ax = a[1], ay = -a[0];
+    const double c = a[2];
+    const double s = std::sqrt(ax * ax + ay * ay);
+    if (s < 1e-9) {
+      if (c > 0) {
+        q_[0] = 1; q_[1] = q_[2] = q_[3] = 0;
+      } else {
+        q_[0] = 0; q_[1] = 1; q_[2] = q_[3] = 0;
+      }
+    } else {
+      const double ang = std::atan2(s, c);
+      ax /= s;
+      ay /= s;
+      q_[0] = std::cos(ang / 2);
+      q_[1] = std::sin(ang / 2) * ax;
+      q_[2] = std::sin(ang / 2) * ay;
+      q_[3] = 0;
+    }
+    for (int i = 0; i < 4; i++) qpub_[i] = q_[i];
+    init_ = true;
+  }
+
+  void integrate(const double w[3], double dt) {
+    const double th = std::sqrt(w[0] * w[0] + w[1] * w[1] + w[2] * w[2]) * dt;
+    if (th < 1e-12) return;
+    const double s = std::sin(th / 2) / (th / dt), c = std::cos(th / 2);
+    const double d[4] = {c, w[0] * s, w[1] * s, w[2] * s};
+    const double a = q_[0], b = q_[1], cc = q_[2], e = q_[3];
+    double r[4] = {a * d[0] - b * d[1] - cc * d[2] - e * d[3], a * d[1] + b * d[0] + cc * d[3] - e * d[2],
+                   a * d[2] - b * d[3] + cc * d[0] + e * d[1], a * d[3] + b * d[2] - cc * d[1] + e * d[0]};
+    const double n = std::sqrt(r[0] * r[0] + r[1] * r[1] + r[2] * r[2] + r[3] * r[3]);
+    for (int i = 0; i < 4; i++) q_[i] = r[i] / n;
+  }
+
+  FilterParams p_;
+  FilterStats st_;
+  double q_[4] = {1, 0, 0, 0};  // w x y z
+  double qpub_[4] = {1, 0, 0, 0};
+  double ifb_[3] = {0, 0, 0};   // integral feedback (= -bias)
+  double acc_[3] = {0, 0, 0};
+  double acc_lp_[3] = {0, 0, 0};
+  double gprev_[3] = {0, 0, 0};
+  double rate_[3] = {0, 0, 0};
+  double b0_ = 0.0, m_ = 0.0;
+  double act_ = 0.0;  // accel activity (EMA of |a - lowpass|)
+  double same_s_ = 0.0, acc_age_ = 1e9;
+  int acc_same_n_ = 0;
+  bool init_ = false, have_acc_ = false, have_gyro_ = false;
+  bool frozen_ = false, despiked_ = false, quiet_ = false;
+};
+
+}  // namespace fc_imu
